{
  "name": "jobwatcher-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "JobWatcher Pages app. Builds into ../docs, which GitHub Pages serves from main.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-docs.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke.mjs --log-level=warning && node node_modules/.cache/smoke.mjs",
    "preview": "vite preview",
    "e2e": "npm run build && playwright test --config e2e/playwright.config.ts",
    "e2e:only": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
